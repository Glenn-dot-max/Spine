# Base de données PostgreSQL
DATABASE_URL=postgresql+psycopg://user:password@localhost:5433/spine

# JWT — génère avec : python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-moi

# Tokens
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Google OAuth (Gmail) — optionnel
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Microsoft OAuth (Outlook) — optionnel
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common

# Docker PostgreSQL
POSTGRES_DB=spine
POSTGRES_USER=spine
POSTGRES_PASSWORD=change-moi